{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MiniWorld Job Radar",
  "version": "0.1.0",
  "identifier": "com.zshining219.miniworld.radar",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiniWorld Job Radar",
        "url": "index.html?surface=radar",
        "width": 420,
        "height": 420,
        "minWidth": 320,
        "minHeight": 320,
        "maxWidth": 900,
        "maxHeight": 700,
        "center": true,
        "alwaysOnTop": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://127.0.0.1:8000; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
