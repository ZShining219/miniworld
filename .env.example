# MiniWorld Agent local configuration. Copy to .env and keep it out of Git.
POSTGRES_PASSWORD=replace-with-a-local-password

# The Demo starts without internet or model credentials.
EXECUTION_MODE=demo
SEED_DEMO_DATA=true
MODEL_PROVIDER_MODE=demo
ALLOW_LIVE_JOB_SEARCH=false
LIVE_JOB_SOURCE=lever
# Comma-separated public Lever company Job Board site identifiers.
LEVER_SITES=binance
LEVER_TIMEOUT_SECONDS=15
# Optional second public source: Greenhouse board tokens (comma-separated).
GREENHOUSE_BOARDS=
# Scheduler source list; demo stays the deterministic default.
RADAR_FETCH_SOURCES=demo
JOB_SCHEDULE_MINUTES=720
SCHEDULER_POLL_SECONDS=5

# Optional job-enrichment provider (demo by default; DeepSeek is opt-in).
JOB_AGENT_PROVIDER=demo
JOB_AGENT_API_KEY=
JOB_AGENT_MODEL=deepseek-chat
JOB_AGENT_BASE_URL=https://api.deepseek.com
JOB_LLM_MAX_PER_RUN=8

# Local interview project bridge. Push needs one of the two channels:
#   INTERVIEW_AGENT_KEY_FILE — path to its data/admin-access.key (admin API)
#   INTERVIEW_AGENT_DIR      — path to the project root (its knowledge CLI)
INTERVIEW_AGENT_BASE_URL=http://127.0.0.1:8788
INTERVIEW_AGENT_KEY_FILE=
INTERVIEW_AGENT_DIR=
INTERVIEW_HANDOFF_DIR=runtime-data/interview-handoff

# Configure these only when explicitly enabling a live remote model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Independent Fitness Coach provider. Keep the real key out of Git.
FITNESS_AGENT_PROVIDER=deepseek
FITNESS_AGENT_API_KEY=
FITNESS_AGENT_MODEL=deepseek-chat
FITNESS_AGENT_BASE_URL=https://api.deepseek.com
FITNESS_AGENT_TIMEOUT_SECONDS=30
