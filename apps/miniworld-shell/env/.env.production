# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# production mode 后台请求地址
# The production H5 always calls the same origin. Caddy removes /fg-api and
# only forwards the Fitness API subtree to FastAPI.
VITE_SERVER_BASEURL = '/fg-api'
VITE_SERVER_BASEURL_SECONDARY = '/fg-api'
