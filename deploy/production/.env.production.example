# Copy to /etc/miniworld/production.env on the server and chmod 600.
# Never commit the real file. Generate POSTGRES_PASSWORD with a cryptographic
# random generator and BASIC_AUTH_HASH with `caddy hash-password`.
PUBLIC_HOST=103-52-153-212.sslip.io
POSTGRES_DB=miniworld
POSTGRES_USER=miniworld
POSTGRES_PASSWORD=replace-with-a-random-hex-value
BASIC_AUTH_HASH=replace-with-a-caddy-password-hash

# Fitness Coach is deployed but remains awaiting_configuration until a real
# key is installed in /etc/miniworld/production.env.
FITNESS_AGENT_PROVIDER=deepseek
FITNESS_AGENT_API_KEY=
FITNESS_AGENT_MODEL=deepseek-chat
FITNESS_AGENT_BASE_URL=https://api.deepseek.com
FITNESS_AGENT_TIMEOUT_SECONDS=30
