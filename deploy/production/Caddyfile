{
	admin off
}

{$PUBLIC_HOST} {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}

	encode zstd gzip

	route {
		basic_auth {
			fitness {$BASIC_AUTH_HASH}
		}

		header {
			X-MiniWorld-Release "{$RELEASE_SHA}"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			-Server
		}

		@fitness_api path /fg-api/api/v1/fitness /fg-api/api/v1/fitness/*
		handle @fitness_api {
			uri strip_prefix /fg-api
			reverse_proxy api:8000
		}

		@blocked_api path /fg-api /fg-api/* /api /api/* /docs /docs/* /redoc /redoc/* /openapi.json
		handle @blocked_api {
			respond "Not found" 404
		}

		@root {
			path /
			not query entry=fitness
		}
		redir @root /?entry=fitness#/pages/fitness/index 302

		handle {
			root * /srv
			header Cache-Control "no-store"

			@immutable path /assets/* /static/*
			header @immutable Cache-Control "public, max-age=31536000, immutable"

			try_files {path} /index.html
			file_server
		}
	}
}
